{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "bash scripts/vercel-install.sh",
  "buildCommand": "echo \"build start: $(date -u +%FT%TZ) apps/api/dist=$(ls apps/api/dist 2>&1 | head -c 80)\" >> packages/shared/dist/.vercel-install-marker && pnpm --filter web build",
  "outputDirectory": "apps/web/dist",
  "framework": null,
  "regions": [
    "sin1"
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 30,
      "includeFiles": "{apps/api/dist/**,packages/shared/dist/**,node_modules/.pnpm/@prisma+client@*/node_modules/.prisma/client/**}"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
