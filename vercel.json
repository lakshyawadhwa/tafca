{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm --filter @ca-practice-os/shared build && pnpm --filter web build",
  "installCommand": "pnpm install --frozen-lockfile",
  "outputDirectory": "apps/web/dist",
  "framework": null,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://REPLACE_WITH_RAILWAY_API_DOMAIN/api/$1" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
