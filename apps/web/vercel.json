{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd ../.. && pnpm --filter @ca-practice-os/shared build && pnpm --filter web build",
  "outputDirectory": "dist",
  "installCommand": "cd ../.. && pnpm install --frozen-lockfile",
  "framework": null,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://REPLACE_WITH_RAILWAY_API_URL/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
