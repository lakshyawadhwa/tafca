model CredentialLockerEntry {
  id                String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  firmId            String     @map("firm_id") @db.Uuid
  clientId          String     @map("client_id") @db.Uuid
  portal            PortalType
  portalLabel       String?    @map("portal_label") @db.VarChar(100)
  username          String     @db.VarChar(200)
  passwordEncrypted String     @map("password_encrypted") @db.Text
  registeredPhone   String?    @map("registered_phone") @db.VarChar(15)
  registeredEmail   String?    @map("registered_email") @db.VarChar(255)
  notes             String?    @db.Text
  lastChangedAt     DateTime?  @map("last_changed_at") @db.Date
  lastAccessedAt    DateTime?  @map("last_accessed_at") @db.Timestamptz()
  lastAccessedBy    String?    @map("last_accessed_by") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  createdBy String    @map("created_by") @db.Uuid
  updatedBy String    @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz()
  deletedBy String?   @map("deleted_by") @db.Uuid

  // Relations
  accessLogs CredentialAccessLog[]

  @@index([firmId])
  @@index([clientId])
  @@map("credential_locker_entries")
}

model CredentialAccessLog {
  id           String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  firmId       String           @map("firm_id") @db.Uuid
  credentialId String           @map("credential_id") @db.Uuid
  accessedBy   String           @map("accessed_by") @db.Uuid
  accessedAt   DateTime         @default(now()) @map("accessed_at") @db.Timestamptz()
  ipAddress    String?          @map("ip_address") @db.VarChar(45)
  action       CredentialAction

  // Relations
  credential CredentialLockerEntry @relation(fields: [credentialId], references: [id])

  @@index([firmId])
  @@index([credentialId])
  @@map("credential_access_log")
}
