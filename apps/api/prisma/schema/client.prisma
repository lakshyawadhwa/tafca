model Client {
  id                  String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  firmId              String            @map("firm_id") @db.Uuid
  displayName         String            @map("display_name") @db.VarChar(200)
  legalName           String?           @map("legal_name") @db.VarChar(300)
  entityType          EntityType        @map("entity_type")
  constitution        ConstitutionType?
  pan                 String?           @db.VarChar(10)
  tan                 String?           @db.VarChar(10)
  cin                 String?           @db.VarChar(21)
  status              ClientStatus      @default(ACTIVE)
  primaryContactName  String?           @map("primary_contact_name") @db.VarChar(100)
  primaryContactPhone String?           @map("primary_contact_phone") @db.VarChar(15)
  primaryContactEmail String?           @map("primary_contact_email") @db.VarChar(255)
  address             Json?             @db.JsonB
  notes               String?           @db.Text
  tags                String[]          @default([]) @db.VarChar(50)
  customFields        Json              @default("{}") @map("custom_fields") @db.JsonB
  assignedPartnerId   String?           @map("assigned_partner_id") @db.Uuid
  assignedManagerId   String?           @map("assigned_manager_id") @db.Uuid
  assignedJuniorId    String?           @map("assigned_junior_id") @db.Uuid
  assignedArticleId   String?           @map("assigned_article_id") @db.Uuid
  onboardedAt         DateTime?         @map("onboarded_at") @db.Date
  financialYearEnd    Int               @default(3) @map("financial_year_end") @db.SmallInt

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  createdBy String    @map("created_by") @db.Uuid
  updatedBy String    @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz()
  deletedBy String?   @map("deleted_by") @db.Uuid

  // Relations
  firm        Firm              @relation(fields: [firmId], references: [id])
  gstNumbers  ClientGstNumber[]
  engagements Engagement[]
  tasks       Task[]
  documents   Document[]

  @@index([firmId])
  @@map("clients")
}

model ClientGstNumber {
  id               String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId         String              @map("client_id") @db.Uuid
  firmId           String              @map("firm_id") @db.Uuid
  gstin            String              @db.VarChar(15)
  stateCode        String              @map("state_code") @db.VarChar(2)
  tradeName        String?             @map("trade_name") @db.VarChar(200)
  registrationType GstRegistrationType @map("registration_type")
  isPrimary        Boolean             @default(false) @map("is_primary")
  registeredAt     DateTime?           @map("registered_at") @db.Date
  cancelledAt      DateTime?           @map("cancelled_at") @db.Date

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  createdBy String    @map("created_by") @db.Uuid
  updatedBy String    @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz()
  deletedBy String?   @map("deleted_by") @db.Uuid

  // Relations
  client Client @relation(fields: [clientId], references: [id])

  @@index([clientId])
  @@index([firmId])
  @@map("client_gst_numbers")
}

model ClientCustomFieldDefinition {
  id           String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  firmId       String          @map("firm_id") @db.Uuid
  fieldKey     String          @map("field_key") @db.VarChar(50)
  label        String          @db.VarChar(100)
  fieldType    CustomFieldType @map("field_type")
  isRequired   Boolean         @default(false) @map("is_required")
  options      String[]        @default([]) @db.VarChar(100)
  displayOrder Int             @default(0) @map("display_order") @db.SmallInt
  isActive     Boolean         @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  createdBy String   @map("created_by") @db.Uuid
  updatedBy String   @map("updated_by") @db.Uuid

  @@unique([firmId, fieldKey])
  @@index([firmId])
  @@map("client_custom_field_definitions")
}
